# gm-bridge configuration — copy to your launcher env or export before starting.
# All values are optional; defaults are shown.

# --- Foundry REST relay (required for dossiers and /do actions) ---
# Credentials are read from process.env first, then from the file at GM_RELAY_ENV.
FOUNDRY_RELAY_URL=http://localhost:3010
FOUNDRY_RELAY_API_KEY=
FOUNDRY_RELAY_CLIENT_ID=fvtt_xxxxxxxxxxxxxxxx
# Fallback env-file with the FOUNDRY_RELAY_* keys (default: <pkg>/foundry-relay.env)
# GM_RELAY_ENV=/path/to/foundry-relay.env

# --- Instance / naming ---
# MCP server + channel name, and the prefix for lock/log files. Must match the
# launcher (server:NAME, --allowedTools mcp__NAME__*); the launcher reads this too.
GM_SERVER_NAME=gm-bridge

# --- LLM backend ---
# claude-channel (default): bridge runs inside a warm claude session (the launcher).
# codex-mcp: standalone bridge that spawns codex itself.
GM_BACKEND=claude-channel
# Short campaign descriptor used by the codex action agent (you may append a
# language instruction, e.g. "...; reply in Russian").
GM_CAMPAIGN=a tabletop RPG campaign (D&D 5e)
# Isolated CODEX_HOME for the codex backend (default: <pkg>/codex-home)
# GM_CODEX_HOME=/path/to/codex-home

# --- Files & ports ---
GM_PORT=8799
# GM_SYSTEM_PROMPT=/path/to/system-prompt.txt   # default: <pkg>/system-prompt.txt
# GM_MEMORY_DB=/path/to/gm-memory.db            # default: <pkg>/data/gm-memory.db
# GM_LOCK_FILE=~/.claude/gm-bridge.pid
# GM_LOG_FILE=~/.claude/gm-bridge.log
# GM_REPLY_TIMEOUT_MS=120000
# Header of the MEMORIES block (set to your campaign language if not English)
# GM_RECALL_HEADER=MEMORIES (past scenes of this campaign; do not contradict them):

# --- Launcher (start-gm-session.sh) ---
# GM_WORKDIR=$HOME      # claude working directory
# GM_MODEL=opus         # claude model
# CLAUDE_BIN=           # path to the claude binary (default: from PATH)
